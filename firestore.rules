rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(gid) {
      return request.auth != null && request.auth.uid in
        get(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
    }
    function active(gid) {
      return getAfter(/databases/$(database)/documents/groups/$(gid)).data.get('deleting', false) == false;
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /groups/{gid} {
      allow read: if member(gid);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.baseCurrency is string
        && request.resource.data.get('hasExpenseHistory', false) == false
        && request.resource.data.get('deleting', false) == false;
      allow update: if member(gid)
        && request.resource.data.baseCurrency == resource.data.baseCurrency
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds.size() > 0
        && (resource.data.get('hasExpenseHistory', true) == false
          || (request.resource.data.get('hasExpenseHistory', true) == true
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)))
        && (resource.data.get('deleting', false) == false
          || request.resource.data == resource.data);
      allow delete: if member(gid) && resource.data.get('deleting', false) == true;

      match /expenses/{eid} {
        function validExpense() {
          let data = request.resource.data;
          return data.groupId == gid
            && data.updatedBy == request.auth.uid
            && data.groupCurrency == getAfter(/databases/$(database)/documents/groups/$(gid)).data.baseCurrency
            && getAfter(/databases/$(database)/documents/groups/$(gid)).data.hasExpenseHistory == true
            && data.originalAmount is number && data.originalAmount > 0
            && data.convertedAmount is number && data.convertedAmount > 0
            && data.paidBy is list && data.paidBy.size() > 0
            && data.participants is list && data.participants.size() > 0
            && data.splitType in ['equal', 'exact', 'percentage', 'shares'];
        }
        allow read: if member(gid);
        allow create: if member(gid) && active(gid) && validExpense()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(gid) && active(gid) && validExpense()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if member(gid);
      }
      match /settlements/{sid} {
        allow read, delete: if member(gid);
      }
      match /activity/{aid} {
        allow read, delete: if member(gid);
      }
    }
  }
}
