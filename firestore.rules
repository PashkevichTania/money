rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(gid) {
      return request.auth != null && request.auth.uid in
        get(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
    }
    function active(gid) {
      return getAfter(/databases/$(database)/documents/groups/$(gid)).data.get('deleting', false) == false;
    }
    function ownerCleanup(gid) {
      let group = get(/databases/$(database)/documents/groups/$(gid)).data;
      return request.auth != null && group.createdBy == request.auth.uid
        && group.get('deleting', false) == true;
    }
    function confirmedFriend(uid) {
      let first = request.auth.uid < uid ? request.auth.uid : uid;
      let second = request.auth.uid < uid ? uid : request.auth.uid;
      let friendship = get(/databases/$(database)/documents/friendships/$(first + ':' + second)).data;
      return friendship.status == 'accepted'
        && request.auth.uid in friendship.memberIds && uid in friendship.memberIds;
    }
    function validMemberChange() {
      let added = request.resource.data.memberIds.removeAll(resource.data.memberIds);
      return added.size() == 0 || (added.size() == 1 && confirmedFriend(added[0]));
    }
    match /friendships/{fid} {
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.memberIds);
      allow list: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['memberIds', 'senderId', 'recipientId', 'status', 'createdAt'])
        && request.resource.data.memberIds is list && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] is string && request.resource.data.memberIds[1] is string
        && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
        && fid == request.resource.data.memberIds[0] + ':' + request.resource.data.memberIds[1]
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.memberIds.hasAll([request.auth.uid, request.resource.data.recipientId])
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.memberIds;
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /groups/{gid} {
      // Queries must prove membership from the queried document itself.
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.baseCurrency is string
        && request.resource.data.get('hasExpenseHistory', false) == false
        && request.resource.data.get('deleting', false) == false;
      allow update: if member(gid)
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == request.resource.data.memberIds.toSet().size()
        && validMemberChange()
        && request.resource.data.baseCurrency == resource.data.baseCurrency
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds.size() > 0
        && resource.data.createdBy in request.resource.data.memberIds
        && (request.resource.data.get('deleting', false) == resource.data.get('deleting', false)
          || request.auth.uid == resource.data.createdBy)
        && (resource.data.get('hasExpenseHistory', true) == false
          || (request.resource.data.get('hasExpenseHistory', true) == true
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)))
        && (resource.data.get('deleting', false) == false
          || request.resource.data == resource.data);
      allow delete: if member(gid) && ownerCleanup(gid);

      match /expenses/{eid} {
        function validExpense() {
          let data = request.resource.data;
          return data.groupId == gid
            && data.updatedBy == request.auth.uid
            && data.groupCurrency == getAfter(/databases/$(database)/documents/groups/$(gid)).data.baseCurrency
            && getAfter(/databases/$(database)/documents/groups/$(gid)).data.hasExpenseHistory == true
            && data.originalAmount is number && data.originalAmount > 0
            && data.convertedAmount is number && data.convertedAmount > 0
            && data.paidBy is list && data.paidBy.size() > 0
            && data.participants is list && data.participants.size() > 0
            && data.splitType in ['equal', 'exact', 'percentage', 'shares'];
        }
        allow read: if member(gid);
        allow create: if member(gid) && active(gid) && validExpense()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if member(gid) && active(gid) && validExpense()
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if member(gid) &&
          ((active(gid) && request.auth.uid == resource.data.createdBy) || ownerCleanup(gid));
      }
      match /settlements/{sid} {
        allow read: if member(gid);
        allow create: if member(gid) && active(gid)
          && request.resource.data.keys().hasOnly(['groupId', 'fromUserId', 'toUserId', 'amount', 'amountMinor', 'currency', 'note', 'createdBy', 'createdAt'])
          && request.resource.data.groupId == gid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.fromUserId != request.resource.data.toUserId
          && request.auth.uid in [request.resource.data.fromUserId, request.resource.data.toUserId]
          && request.resource.data.fromUserId in getAfter(/databases/$(database)/documents/groups/$(gid)).data.memberIds
          && request.resource.data.toUserId in getAfter(/databases/$(database)/documents/groups/$(gid)).data.memberIds
          && request.resource.data.currency == getAfter(/databases/$(database)/documents/groups/$(gid)).data.baseCurrency
          && getAfter(/databases/$(database)/documents/groups/$(gid)).data.hasExpenseHistory == true
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor > 0 && request.resource.data.amountMinor <= 99999999900
          && request.resource.data.amount is number
          && request.resource.data.amount == request.resource.data.amountMinor / 100.0
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && request.resource.data.createdAt is string;
        allow delete: if member(gid) && ((active(gid) && resource.data.createdBy == request.auth.uid) || ownerCleanup(gid));
      }
      match /activity/{aid} {
        allow read: if member(gid);
        allow delete: if member(gid) && ownerCleanup(gid);
      }
    }
  }
}
